app/macos/Pods/
app/windows/flutter/ephemeral/
app/linux/flutter/ephemeral/

# ----------------------------------------------------------------------------
#  PCB design — KiCad / Fritzing (PCBs/)
#  Keep sources (.kicad_sch/.kicad_pcb/.kicad_pro/.fzz), gerbers, BoM and
#  rendered images. Ignore backups, caches and router temp files.
# ----------------------------------------------------------------------------
*-backups/
_autosave-*
*.kicad_prl
fp-info-cache
*.lck
*.kicad_pcb-bak
*.kicad_sch-bak
*-erc.rpt
*-drc.rpt
*.dsn
*.ses
*.step
*.stp
*.wrl

# ----------------------------------------------------------------------------
#  Secrets — keep credentials out of version control
# ----------------------------------------------------------------------------
.env
*.env
.env.*
google-services.json
GoogleService-Info.plist
secrets.h

# ----------------------------------------------------------------------------
#  Python (ESP-IDF helper venvs, if any)
# ----------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
venv/
.venv/

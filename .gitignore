# ============================================================================
#  Smart Campus Automation — Graduation Project (MIU)
#  Only technical work is published: firmware, mobile app, PCB designs,
#  Firebase data model and technical docs. Everything else stays local.
# ============================================================================

# ----------------------------------------------------------------------------
#  Local-only material (thesis, slides, poster, videos, research, rubrics,
#  3D-printing files, old code copies). Never pushed.
# ----------------------------------------------------------------------------
_private/

# ----------------------------------------------------------------------------
#  Safety net: non-technical file types anywhere in the repo
# ----------------------------------------------------------------------------
# Office documents & PDFs (thesis drafts, slides, brochures, papers)
*.doc
*.docx
*.ppt
*.pptx
*.pdf
*.xls
*.xlsx
!PCBs/BOM/*.xlsx
~$*

# Video / audio / editing projects
*.mp4
*.mov
*.MOV
*.avi
*.mkv
*.mp3
*.wav
*.m4a
*.tscproj

# Design-tool sources & stock assets (poster/brochure)
*.ai
*.eps
*.psd
*.avif
*.webp

# AI-generated concept images, screenshots, chat images
ChatGPT Image*
Gemini_Generated_Image*
Screenshot*
WhatsApp Image*

# Archives (sources are already in the repo unpacked)
*.zip
*.rar
*.7z

# Scratch notes
tasks.md
firmware/main.md
firmware/final discussion.md
*.scratch
_scratch/

# ----------------------------------------------------------------------------
#  OS / editor cruft
# ----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
.directory
*~
*.swp
*.swo
*.bak
*.tmp
*.log

# IDE / tooling
.idea/
.vscode/
!firmware/**/.vscode/
.claude/
*.iml
*.ipr
*.iws
.history
.clangd/
.ccls-cache/
compile_commands.json

# ----------------------------------------------------------------------------
#  Firmware — ESP-IDF (firmware/control, firmware/zone, firmware/common)
# ----------------------------------------------------------------------------
**/build/
managed_components/
.espressif/
sdkconfig
sdkconfig.old
flasher_args.json
*.o
*.a
*.out
*.elf
*.bin
*.map

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# ----------------------------------------------------------------------------
#  Mobile app — Flutter / Dart (app/)
# ----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
app/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json
app/android/app/debug
app/android/app/profile
app/android/app/release
app/android/.gradle/
app/android/.kotlin/
app/android/local.properties
app/ios/Pods/
